# .env.example — 실제 .env 파일로 복사 후 값을 채우세요.
# 절대로 .env 파일을 Git 에 커밋하지 마세요 (.gitignore 에 반드시 포함).

# ── 필수 ─────────────────────────────────────────────────────
BOT_KEY=여기에_봇_키_입력
SWAPGO_BASE_URL=http://localhost:8000

# ── 풀 ID ─────────────────────────────────────────────────────
POOL_ID=1        # BTC 풀
ETH_POOL_ID=2    # ETH 풀 (8피처 중 Ret_eth·Volume_eth 계산에 사용)

# ── 심볼 ─────────────────────────────────────────────────────
SYMBOLS=["BTC","ETH"]

# ── AI 모델 ─────────────────────────────────────────────────
MODEL_SCALPER_PATH=models/model_scalper.onnx
MODEL_SWING_PATH=models/model_swing.onnx
MODEL_LONGTERM_PATH=models/model_longterm.onnx
MODEL_TAG=gru-v1

# ── Scaler ──────────────────────────────────────────────────
# 학습 시 사용한 sklearn scaler (joblib 직렬화)
# 없으면 Mock 모드 (정규화 생략, 개발 전용)
SCALER_PATH=models/scaler.pkl

# ── 출력 EMA 평활 ────────────────────────────────────────────
EMA_ALPHA=0.3

# ── 캔들 수집 ────────────────────────────────────────────────
# 모델이 1초 틱 기반이므로 가능한 짧은 간격 권장
CANDLE_INTERVAL=1m
CANDLE_LIMIT=200

# ── ingest 주기 ──────────────────────────────────────────────
INGEST_INTERVAL_SEC=60

# ── 자동거래 (패턴 B) ────────────────────────────────────────
ENABLE_AUTO_TRADE=false
TRADE_CONFIDENCE_THRESHOLD=0.7
TRADE_AMOUNT_HUMAN=10
TRADE_SLIPPAGE_BPS=100

# ── WebSocket (패턴 B 보조) ──────────────────────────────────
USE_WEBSOCKET=false

# ── LP 봇 (패턴 C) ───────────────────────────────────────────
ENABLE_LP_BOT=false
