# .env.example — 실제 .env 파일로 복사 후 값을 채우세요.
# 절대로 .env 파일을 Git 에 커밋하지 마세요 (.gitignore 에 반드시 포함).

# ── 필수 ─────────────────────────────────────────────────────
# 서버 첫 부팅 시 콘솔에 출력되는 raw 키
SWAPGO_BOT_KEY=여기에_봇_키_입력

# SwapGo 백엔드 주소
SWAPGO_BASE_URL=http://localhost:8000

# ── 대상 풀 / 심볼 ───────────────────────────────────────────
POOL_ID=1
SYMBOLS=["BTC","ETH"]

# ── ingest 주기 (초, 최소 30) ────────────────────────────────
INGEST_INTERVAL_SEC=60

# ── 자동거래 (패턴 B) ────────────────────────────────────────
ENABLE_AUTO_TRADE=false
TRADE_CONFIDENCE_THRESHOLD=0.7
TRADE_AMOUNT_HUMAN=10

# ── WebSocket 실시간 봇 (패턴 B 보조) ────────────────────────
USE_WEBSOCKET=false

# ── LP 봇 (패턴 C) ───────────────────────────────────────────
ENABLE_LP_BOT=false

# ── AI 모델 경로 ─────────────────────────────────────────────
MODEL_SCALPER_PATH=models/model_scalper.onnx
MODEL_SWING_PATH=models/model_swing.onnx
MODEL_LONGTERM_PATH=models/model_longterm.onnx
MODEL_TAG=gru-v1

# ── AI 스케일링 (훈련 시 사용한 scaler 수치로 교체 필수) ──────
PRICE_INPUT_SCALE=100000.0
PRED_OUTPUT_SCALE=1000.0
EMA_ALPHA=0.3
